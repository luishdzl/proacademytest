---
import { Icon } from "astro-icon/components";
import Base from "@/layouts/Base.astro";
import FAQList from "@/components/FAQList.astro";
import HourPricePicker from "@/components/HourPricePicker.astro";
import { PAA_HOUR_PACKAGES, TOEFL_HOUR_PACKAGES } from "@/data/hour-packages";
import { getFigmaLanding } from "@/data/landing-figma";
import { PROGRAMS, pricingPath, testimonialsPath } from "@/data/programs";
import { SITE } from "@/data/site";
import { TESTIMONIALS } from "@/data/testimonials";
import { getPostsByCategory, getPublishedPosts } from "@/lib/blog";
import { breadcrumbSchema, courseSchema, faqSchema } from "@/lib/schema";

export function getStaticPaths() {
  return PROGRAMS.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

const { program } = Astro.props;
const landing = getFigmaLanding(program.slug);
const isSat = program.slug === "sat";
const money = (amount: number) => `$${amount.toLocaleString("en-US")}`;

const featureIcons = ["ph:book-open", "ph:clipboard-text", "ph:graduation-cap", "ph:seal-check"];
const examIconsBySlug: Record<string, string[]> = {
  sat: ["ph:book-open", "ph:math-operations"],
  paa: ["ph:book-open", "ph:pencil-simple", "ph:calculator", "ph:globe-hemisphere-west"],
  "piense-ii": ["ph:target", "ph:book-open", "ph:calculator", "ph:globe-hemisphere-west"],
  act: ["ph:globe-hemisphere-west", "ph:calculator", "ph:book-open", "ph:target", "ph:pencil-simple-line"],
  gre: ["ph:pencil-simple", "ph:book-open", "ph:calculator", "ph:stack"],
  gmat: ["ph:chart-line-up", "ph:book-open", "ph:calculator", "ph:lightning"],
};
const examIcons = examIconsBySlug[program.slug] ?? ["ph:book-open", "ph:headphones", "ph:pencil-simple", "ph:microphone"];
const academicIntro = program.academicIntro ?? program.audience;

const priceBenefits = [
  "Recibe retroalimentación en clases 1 a 1",
  "Estudia con materiales y simuladores actuales",
  "Planes flexibles, cuando y donde quieras",
  "Obtén el puntaje que necesitas... ¡garantizado!",
];

type PlanFeature = string | { label: string; note: string };
const plans: {
  essentialPrice: string;
  essential: PlanFeature[];
  advanced: PlanFeature[];
  elitePrice: string;
  eliteBefore: string;
  elite: PlanFeature[];
} = {
  essentialPrice: "$2,490",
  essential: [
    "Acceso a la plataforma digital",
    "+20 exámenes de simulación",
    "Tutor de IA Integrado",
    "+5,000 preguntas de práctica",
    "Lecciones en video",
  ],
  advanced: [
    "Diagnóstico de tu nivel",
    "Plan de estudio personalizado",
    { label: "Clases 1:1 en vivo", note: program.slug === "toefl-ibt" ? "5 a 15 h (ajustable según diagnóstico)" : "10 a 20 h (ajustable según diagnóstico)" },
    "Horarios flexibles adaptables",
  ],
  elitePrice: landing.elitePrice ?? "$24,650",
  eliteBefore: landing.eliteBefore ?? "$29,000",
  elite: [
    `${landing.eliteHours ?? 40} horas de clase en vivo 1:1`,
    "Maestros certificados",
    "Retroalimentación detallada",
    "Kit de estrategia para el día del examen",
  ],
};

const blogCategoryByCourse: Record<string, string> = { "toefl-ibt": "toefl", "piense-ii": "admisiones", act: "admisiones" };
const examKeyword = program.exam.toLowerCase().split(/[\s-]/)[0];
const allPosts = await getPublishedPosts();
const candidates = [
  ...(await getPostsByCategory(blogCategoryByCourse[program.slug] ?? program.slug)),
  ...allPosts.filter((p) => `${p.data.title} ${p.data.description}`.toLowerCase().includes(examKeyword)),
  ...(await getPostsByCategory("admisiones")),
  ...(await getPostsByCategory("universidades")),
  ...(await getPostsByCategory("consejos-de-estudio")),
];
const relatedPosts = [...new Map(candidates.map((p) => [p.id, p])).values()].slice(0, 3);

// Preguntas de costo y modalidad: cubren búsquedas de compra y alimentan el FAQPage.
const faqs = [
  ...program.faqs,
  {
    q: `¿Cuánto cuesta el curso ${program.exam}?`,
    a: `Los planes del curso ${program.exam} van de ${money(program.priceFromMXN ?? program.priceMXN)} a ${money(program.priceToMXN ?? program.priceMXN)} MXN, según el plan y las horas de clase 1 a 1 que elijas. Consulta el detalle en la página de precios.`,
  },
  {
    q: "¿Las clases son en línea y con horarios flexibles?",
    a: "Sí. Las clases 1 a 1 son en vivo y en línea, y los horarios se adaptan a tu disponibilidad.",
  },
];

const courseTestimonials = TESTIMONIALS.filter((t) => t.program.toUpperCase() === landing.testimonialKey);

const schema = [
  courseSchema(program),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Cursos", url: `${SITE.url}/#programas` },
    { name: program.exam, url: `${SITE.url}/${program.slug}` },
  ]),
];
---

<Base title={program.metaTitle} description={program.metaDescription} schema={schema} stickyCta={false}>
  <div data-course={program.slug}>
  <!-- HERO (oscuro) -->
  <section class="course-hero relative overflow-hidden hairline-b-dim" style="background-color: rgb(6 10 10)">
    <div class="pointer-events-none absolute -right-32 top-0 h-[34rem] w-[34rem] rounded-full bg-teal-600/12 blur-[130px]" aria-hidden="true"></div>

    <div class="container-edge relative pb-16 pt-36 lg:pt-40 lg:min-h-[45rem] lg:pb-14">
      <div class="relative z-10 max-w-2xl lg:max-w-[55%] xl:max-w-[58%] lg:pt-4">
        <nav aria-label="Ruta de navegación" class="font-mono text-[11px] tracking-[0.18em] text-ink-400 uppercase">
          <a href="/" class="transition-colors hover:text-teal-300">Inicio</a>
          <span aria-hidden="true"> / </span>
          <a href="/#programas" class="transition-colors hover:text-teal-300">Cursos</a>
          <span aria-hidden="true"> / </span>
          <span class="text-teal-400">{program.exam}</span>
        </nav>

        <div class="mt-5">
          <h1 class="font-display text-[clamp(2.5rem,5.2vw,4.25rem)] leading-[1.08] font-semibold tracking-[-0.03em] text-pearl">
            {landing.heroLines.map((line) => (<Fragment>{line}<br /></Fragment>))}
            <span class="text-[#00cfab]">¡garantizado!</span>
          </h1>
          <p class="mt-6 max-w-lg text-[17px] leading-relaxed text-ink-300">
            {landing.heroSub}
          </p>
        </div>

        <div class="mt-9 flex flex-wrap items-center gap-4" data-reveal>
          <a href="#precios" class="inline-flex items-center justify-center rounded-full bg-[#00cfab] px-8 py-3.5 font-display text-[13px] font-bold tracking-widest text-[#061713] transition-transform hover:scale-[1.02] shadow-md uppercase" data-magnetic data-event={`program_cta_${program.slug}`}>
            VER PRECIOS
          </a>
          <a href="#contacto" class="inline-flex items-center justify-center rounded-full bg-[#121c19] border border-white/10 px-8 py-3.5 font-display text-[13px] font-bold tracking-widest text-pearl transition-colors hover:bg-white/10 uppercase" data-magnetic>
            HAZ TU DIAGNÓSTICO GRATIS
          </a>
        </div>
      </div>

      <div class="course-hero-image-wrapper pointer-events-none relative mx-auto mt-12 w-full max-w-xl sm:max-w-2xl lg:absolute lg:right-0 xl:right-4 lg:bottom-0 lg:mx-0 lg:mt-0 lg:w-[54%] lg:max-w-[720px] xl:max-w-[760px]">
        {(
        <div class="course-seal absolute -top-7 -left-7 sm:-top-9 sm:-left-9 lg:-top-11 lg:-left-11 z-20 size-40 sm:size-48 lg:size-52 select-none">
          <svg viewBox="-12 -12 224 224" class="size-full font-display overflow-visible" aria-hidden="true" text-rendering="geometricPrecision">
            <defs>
              <filter id="paaSealShadow" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#000" flood-opacity="0.55" /></filter>
              <linearGradient id="paaSealGrad" x1="15%" y1="10%" x2="85%" y2="90%">
                <stop offset="0%" stop-color="#09695b" />
                <stop offset="55%" stop-color="#0b7f6e" />
                <stop offset="100%" stop-color="#0f8d79" />
              </linearGradient>
              <path id="paaSealWave" d="M 182.00 100.00 Q 199.10 126.55 171.01 141.00 Q 172.55 172.55 141.00 171.01 Q 126.55 199.10 100.00 182.00 Q 73.45 199.10 59.00 171.01 Q 27.45 172.55 28.99 141.00 Q 0.90 126.55 18.00 100.00 Q 0.90 73.45 28.99 59.00 Q 27.45 27.45 59.00 28.99 Q 73.45 0.90 100.00 18.00 Q 126.55 0.90 141.00 28.99 Q 172.55 27.45 171.01 59.00 Q 199.10 73.45 182.00 100.00 Z" />
            </defs>
            <g transform="rotate(-6 100 100)">
            <use href="#paaSealWave" fill="url(#paaSealGrad)" filter="url(#paaSealShadow)" />
            <use href="#paaSealWave" fill="none" stroke="#2dd4bf" stroke-width="1.35" opacity="0.85" transform="translate(100,100) scale(0.87) translate(-100,-100)" />
            <text x="100" y="65" text-anchor="middle" fill="#a7f3d0" font-size="13.5" font-weight="600" letter-spacing="3">GARANTÍA</text>
            <text x="100" y="109" text-anchor="middle" fill="#ffffff" font-size="38" font-weight="800" letter-spacing="-1">+{landing.sealPoints} <tspan font-size="13.5" font-weight="700" letter-spacing="0" dy="-2">pts</tspan></text>
            <text x="100" y="135" text-anchor="middle" fill="#e6fffb" font-size="9.5" font-weight="600" opacity="1">sobre tu diagnóstico inicial</text>
            </g>
          </svg>
        </div>
        )}
        {program.heroImage ? (
          <img
            src={program.heroImage.src}
            alt={`Garantía +${landing.sealPoints} pts sobre tu diagnóstico inicial - Plataforma de práctica ${landing.label}`}
            width={program.heroImage.width}
            height={program.heroImage.height}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class:list={["w-full", program.slug === "sat" && "aspect-[1262/766] object-cover object-left-top"]}
          />
        ) : (
          <div class="aspect-[1262/766] w-full rounded-2xl border border-white/10 bg-gradient-to-br from-[#0c2f27] via-[#08201a] to-[#061411] sm:rounded-3xl" aria-hidden="true"></div>
        )}
      </div>
    </div>
  </section>

  <!-- MÉTRICAS -->
  <section class="hairline-b course-metrics-paa" aria-label="El programa en números">
    <div class="container-edge grid grid-cols-2 lg:grid-cols-4">
      {landing.stats.map((s) => (
        <div class="px-5 py-9 sm:px-6" data-reveal>
          <p class="font-display whitespace-nowrap text-[1.7rem] font-semibold tracking-tight text-ink-950 min-[420px]:text-[2.1rem] sm:text-[2.75rem]">{s.prefix && <span class="text-[#00cfab]">{s.prefix}</span>}{s.text ? s.text : s.value?.toLocaleString("es-MX")}</p>
          <p class="mt-2 font-mono text-[10px] tracking-[0.18em] uppercase text-teal-200/60">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

    <!-- ======================================================== -->
    <!-- 1. DOMINA TU EXAMEN PAA (la chica + tabs)                -->
    <!-- 2. PREPARACIÓN ACADÉMICA A TU MEDIDA (4 tarjetas)        -->
    <!-- 3. ENTRENA COMO SI YA FUERA EL DÍA DEL EXAMEN (mockup)   -->
    <!-- 4. LA MEJOR OPCIÓN PARA APROBAR (Precios 3 tarjetas)     -->
    <!-- 5. ELLOS YA LOGRARON SU META (Testimonios PAA)           -->
    <!-- 6. RESOLVEMOS TUS DUDAS (Laptop + FAQs)                  -->
    <!-- ======================================================== -->

    <!-- 1. DOMINA TU EXAMEN PAA, TODAS LAS SECCIONES (oscuro) -->
    <section class="course-sections relative overflow-hidden pt-12 pb-16 hairline-t-dim" style="background-color: rgb(8 13 13)" aria-label={`Secciones del examen ${program.exam}`}>
      <div class="pointer-events-none absolute -left-40 top-0 h-[40rem] w-[40rem] rounded-full bg-[#0a1f1c] blur-[60px]" aria-hidden="true"></div>

      <div class="container-edge grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12 items-end">
        <!-- Columna izquierda: Figura verde orgánica + Chica + Check (Figma) -->
        <div class="relative flex items-end justify-center self-end min-h-[380px] sm:min-h-[460px] lg:min-h-[540px]" data-reveal>
          <div class="pointer-events-none absolute -left-[28%] bottom-[-12%] h-[96%] w-[150%] rounded-[50%] bg-[#0c2b24]/70" aria-hidden="true"></div>

          <!-- Badge flotante check circular verde como en Figma -->
          <img src="/images/check-badge.svg" alt="" width="72" height="72" aria-hidden="true" class="course-check absolute left-2 sm:left-6 lg:-left-3 xl:-left-14 top-[12%] z-20 size-14 lg:size-[4.5rem]" />

          <!-- Estudiante sentada con tablet -->
          <img
            src={program.skillsImage}
            alt={`Estudiante preparándose para el examen ${program.exam}`}
            width="812"
            height="745"
            loading="lazy"
            decoding="async"
            class="student-img relative z-10 w-full max-w-[420px] sm:max-w-[520px] lg:max-w-none object-contain object-bottom" style={`--sw: ${landing.studentWidth ?? 150}%`}
          />
        </div>

        <!-- Columna de Tabs a la derecha -->
        <div class="course-exam-details relative z-10 w-full min-w-0 lg:pt-8 lg:pb-6 lg:max-w-[554px]" data-reveal>
          <h2 class="font-display text-4xl font-semibold leading-[1.05] tracking-tight text-pearl sm:text-5xl">
            {landing.examHeading}<br />
            <span class="text-[#00cfab]">todas las secciones.</span>
          </h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-300">
            {landing.examIntro}
          </p>

          <div class="mt-8" data-exam-tabs>
            <div class="flex gap-1.5 overflow-x-auto rounded-[2rem] border border-white/5 bg-[#0b1613]/50 p-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" style={(program.examSections?.length ?? 4) <= 2 ? "max-width: 17rem" : undefined} role="tablist" aria-label={`Secciones del examen ${program.exam}`}>
              {program.examSections?.map((s, i) => (
                <button
                  type="button"
                  role="tab"
                  class="exam-tab flex shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-full px-3.5 py-2.5 font-display text-sm font-semibold text-ink-400 transition-all border border-transparent sm:flex-1 sm:shrink sm:px-2"
                  data-exam-tab
                  data-index={i}
                  id={`exam-tab-paa-${i}`}
                  aria-controls={`exam-panel-paa-${i}`}
                  tabindex={i === 0 ? 0 : -1}
                  aria-selected={i === 0 ? "true" : "false"}
                >
                  <Icon name={examIcons[i] ?? "ph:circle"} class="size-[1.125rem] shrink-0 opacity-70 transition-opacity" aria-hidden="true" />
                  <span>{s.tabLabel ?? s.name}</span>
                </button>
              ))}
            </div>

            {program.examSections?.map((s, i) => (
              <div class="exam-panel mt-4 flex min-h-[35rem] flex-col justify-between overflow-hidden rounded-[1.5rem] border border-white/[0.04] bg-transparent backdrop-blur-xl shadow-2xl shadow-black/20 sm:min-h-[32rem]" data-exam-panel data-index={i} id={`exam-panel-paa-${i}`} role="tabpanel" aria-labelledby={`exam-tab-paa-${i}`} tabindex="0" hidden={i !== 0}>
                <!-- Mitad superior azul/turquesa -->
                <div class="flex flex-1 flex-col justify-between bg-[#172c26]/75 p-7 sm:p-8">
                  <div>
                    <h3 class="font-display text-2xl font-semibold tracking-tight text-pearl sm:text-[1.7rem]">
                      {s.name}{s.panelSuffix && <span class="font-normal text-pearl/85"> — {s.panelSuffix}</span>}
                    </h3>
                    <p class="mt-3.5 max-w-2xl text-[15px] leading-relaxed text-pearl/70">{s.description}</p>
                  </div>

                  <div class="mt-8 flex flex-wrap gap-x-12 gap-y-4">
                    {s.structure && (
                      <div>
                        <p class="font-mono text-[9px] font-bold tracking-[0.2em] text-pearl/40 uppercase">Estructura</p>
                        <p class="mt-1 font-display text-[17px] font-semibold text-pearl">{s.structure}</p>
                      </div>
                    )}
                    <div>
                      <p class="font-mono text-[9px] font-bold tracking-[0.2em] text-pearl/40 uppercase">Tiempo total</p>
                      <p class="mt-1 font-display text-[17px] font-semibold text-pearl">{s.time}</p>
                    </div>
                    <div>
                      <p class="font-mono text-[9px] font-bold tracking-[0.2em] text-pearl/40 uppercase">Puntaje de sección</p>
                      <p class="mt-1 font-display text-[17px] font-semibold text-[#00cfab]">
                        {s.scoreRange} 
                        <span class="text-[13px] font-normal text-pearl/40 ml-1">puntos</span>
                      </p>
                    </div>
                  </div>
                </div>

                <!-- Mitad inferior oscura -->
                <div class="flex flex-1 flex-col justify-center bg-[#121413]/75 p-7 pt-6 sm:px-8 sm:pb-8 sm:pt-7">
                  <div>
                    <p class="font-mono text-[9px] font-bold tracking-[0.2em] text-pearl/40 uppercase">Actividades de la sección</p>
                    <ul class="mt-5 space-y-6">
                      {s.activities.map((a, j) => (
                        <li class="flex gap-4">
                          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-[#1e3c33] font-mono text-[13px] font-semibold text-[#00cfab]">{j + 1}</span>
                          <div class="pt-0.5">
                            <p class="font-display text-[15px] font-semibold tracking-wide text-pearl">{a.title}</p>
                            <p class="mt-1 text-[14px] leading-relaxed text-pearl/60">{a.detail}</p>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. PREPARACIÓN ACADÉMICA A TU MEDIDA (blanco) -->
    <section class="course-preparation py-24 bg-white">
      <div class="container-edge">
        <h2 class="text-3xl sm:text-5xl font-display font-semibold tracking-tight text-ink-950" data-reveal>
          Preparación académica <span class="text-[#008f7a]">a tu medida.</span>
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-600" data-reveal>{academicIntro}</p>

        <div class="mt-12 grid gap-5 lg:grid-cols-12">
          {program.features.map((f, i) => {
            const isWide = i === 0 || i === program.features.length - 1;
            const img = i === 0 ? program.guideImage : i === program.features.length - 1 ? program.guaranteeImage : undefined;
            return (
              <div class:list={[
                "relative flex flex-col justify-center overflow-hidden rounded-3xl border border-ink-950/[0.04] p-7 sm:p-8 min-h-[190px]",
                "bg-[#ebedec]",
                isWide ? "lg:col-span-8" : "lg:col-span-4"
              ]} data-reveal>
                <div class:list={["relative z-10", isWide ? "max-w-xs sm:max-w-sm lg:max-w-[19rem] xl:max-w-[21rem]" : "max-w-full"]}>
                  <div class="flex items-center gap-4">
                    <span class="grid size-12 shrink-0 place-items-center rounded-full bg-[#008f7a] text-white shadow-sm">
                      <Icon name={featureIcons[i] ?? "ph:check"} class="size-6 text-white" aria-hidden="true" />
                    </span>
                    <h3 class="font-display text-xl sm:text-[1.28rem] font-semibold tracking-tight text-ink-950">{f.title}</h3>
                  </div>
                  <p class="mt-3.5 text-[14px] sm:text-[15px] leading-relaxed text-ink-600">{f.detail}</p>
                </div>
                {img && (
                  <img
                    src={img}
                    alt={f.title}
                    width={i === 0 ? "800" : "944"}
                    height={i === 0 ? "977" : "740"}
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      "pointer-events-none absolute object-contain transition-opacity drop-shadow-md",
                      i === 0
                        ? "right-4 sm:right-10 -bottom-10 sm:-bottom-12 w-40 sm:w-48 lg:w-[220px]"
                        : "right-3 sm:right-6 bottom-0 w-44 sm:w-52 lg:w-[250px]"
                    ]}
                    aria-hidden="true"
                  />
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 3. ENTRENA COMO SI YA FUERA EL DÍA DEL EXAMEN (oscuro) -->
    <section class="relative overflow-hidden py-24 hairline-t-dim hairline-b-dim" style="background-color: rgb(8 16 14)" aria-label={`Plataforma de simulación ${program.exam}`}>
      <div class="pointer-events-none absolute -left-24 top-1/2 -translate-y-1/2 h-[42rem] w-[62rem] rounded-[50%] bg-[#0c2b24]/45 blur-[2px] -rotate-12" aria-hidden="true"></div>
      <div class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 h-[38rem] w-[38rem] rounded-full bg-teal-600/10 blur-[130px]" aria-hidden="true"></div>

      <div class="container-edge relative grid items-center gap-12 lg:grid-cols-[1.02fr_0.98fr] lg:gap-16">
        <div data-reveal>
          <h2 class="font-display text-[clamp(2.15rem,4vw,3.25rem)] font-semibold leading-[1.08] tracking-tight text-pearl">
            {landing.platformHeading ? (
              <Fragment>{landing.platformHeading.line}<br /><span class="text-[#00cfab]">{landing.platformHeading.accent}</span></Fragment>
            ) : (
              <Fragment>Entrena como si ya<br />fuera <span class="text-[#00cfab]">el día del examen.</span></Fragment>
            )}
          </h2>

          <p class="mt-5 max-w-xl text-[16px] sm:text-[17px] leading-relaxed text-ink-300">
            {landing.platformIntro}
          </p>

          <ul class="mt-8 divide-y divide-white/10 border-t border-white/10">
            {landing.platformBullets.map((item) => (
              <li class="flex items-start gap-4 py-5">
                <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-teal-950/90 border border-teal-500/30 text-[#00cfab] mt-0.5">
                  <Icon name={item.icon} class="size-5" />
                </span>
                <div>
                  <h3 class="font-display text-[16px] font-semibold text-pearl">{item.title}</h3>
                  <p class="mt-1 text-[14px] leading-relaxed text-ink-300">{item.detail}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tarjeta de progreso de plataforma (Asset de Figma) -->
        <div class="relative mx-auto w-full max-w-lg lg:max-w-none flex justify-center" data-reveal>
          <div class="relative w-full max-w-[540px]">
