<script>
  document.querySelectorAll<HTMLElement>("[data-testimonial-track]").forEach((track) => {
    const root = track.closest("section");
    const step = () => Math.max(track.clientWidth * 0.8, 280);
    root?.querySelector("[data-testimonial-prev]")?.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    root?.querySelector("[data-testimonial-next]")?.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
  });
</script>

<script>
  document.querySelectorAll<HTMLElement>("[data-elite-price]").forEach((box) => {
    const toggle = box.querySelector<HTMLButtonElement>("[data-cash-toggle]");
    if (!toggle) return;
    const value = box.querySelector<HTMLElement>("[data-price-value]");
    const before = box.querySelector<HTMLElement>("[data-price-before]");
    toggle.addEventListener("click", () => {
      const on = toggle.getAttribute("aria-checked") !== "true";
      toggle.setAttribute("aria-checked", String(on));
      if (value) value.textContent = on ? (box.dataset.cash ?? "") : (box.dataset.list ?? "");
      before?.classList.toggle("hidden", !on);
    });
  });
</script>

