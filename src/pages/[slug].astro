<script define:vars={{ whatsapp: SITE.whatsapp, exam: program.exam, isModernCourse: true, isSat }}>
  function initCoursePage() {
    // Tabs de secciones del examen
    const tabsRoot = document.querySelector("[data-exam-tabs]");
    if (tabsRoot && !tabsRoot.dataset.bound) {
      tabsRoot.dataset.bound = "true";
      const tabs = Array.from(tabsRoot.querySelectorAll("[data-exam-tab]"));
      const panels = Array.from(tabsRoot.querySelectorAll("[data-exam-panel]"));
      tabsRoot.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        const current = tabs.indexOf(document.activeElement);
        if (current < 0) return;
        event.preventDefault();
        const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (current + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        tabs[next].click();
        tabs[next].focus();
      });
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const idx = tab.dataset.index;
          tabs.forEach((t) => {
            t.setAttribute("aria-selected", String(t === tab));
            t.tabIndex = t === tab ? 0 : -1;
          });
          panels.forEach((p) => (p.hidden = p.dataset.index !== idx));
        });
      });
    }

    // Formulario de mensaje
    const form = document.getElementById("course-msg-form");
    if (form && !form.dataset.bound) {
      form.dataset.bound = "true";
      const status = document.getElementById("course-msg-status");
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const nombre = String(data.get("nombre") || "").trim();
        const correo = String(data.get("correo") || "").trim();
        const telefono = String(data.get("telefono") || "").trim();
        const setError = (name, msg) => {
          const el = form.querySelector(`[name="${name}"]`);
          el?.setAttribute("aria-invalid", "true");
          el?.focus();
          if (status) {
            status.style.color = "";
            status.textContent = msg;
          }
        };
        if (nombre.length < 2) return setError("nombre", "Escribe tu nombre para continuar.");
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo)) return setError("correo", "Escribe un correo válido.");
        form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
        if (status) {
          status.style.color = "";
          status.textContent = "Enviando mensaje…";
        }
        const isModern = (typeof isModernCourse !== "undefined" && Boolean(isModernCourse)) || (typeof isSat !== "undefined" && Boolean(isSat));
        if (isModern) {
          if (form.dataset.submitting === "true") return;
          form.dataset.submitting = "true";
          const submit = form.querySelector('button[type="submit"]');
          if (submit) submit.disabled = true;
          const controller = new AbortController();
          const timeout = setTimeout(() => controller.abort(), 15000);
          fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            signal: controller.signal,
            body: JSON.stringify({ nombre, correo, telefono, curso: exam, fromUrl: window.location.href }),
          }).then(async (response) => {
            if (!response.ok || !(await response.json()).success) throw new Error("contact_failed");
            if (status) status.textContent = "¡Mensaje enviado! Nuestro equipo se pondrá en contacto contigo.";
            window.dataLayer?.push({ event: "generate_lead", lead_exam: exam });
          }).catch(() => {
            if (status) status.textContent = "No pudimos enviar el mensaje. Inténtalo de nuevo o contáctanos por WhatsApp.";
          }).finally(() => {
            clearTimeout(timeout);
            form.dataset.submitting = "false";
            if (submit) submit.disabled = false;
            if (status) {
              const link = document.createElement("a");
              link.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(`Hola, me llamo ${nombre}. Quiero informes del curso ${exam}. Mi correo: ${correo}${telefono ? `. Mi teléfono: ${telefono}` : ""}`)}`;
              link.target = "_blank";
              link.rel = "noopener noreferrer";
              link.className = "block mt-3 underline underline-offset-4";
              link.textContent = "Continuar por WhatsApp";
              status.append(link);
            }
          });
          return;
        }

        if (form.dataset.submitting === "true") return;
        form.dataset.submitting = "true";
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        const msg = [
          `Hola, me llamo ${nombre}.`,
          `Quiero informes del curso ${exam}.`,
          correo ? `Mi correo: ${correo}` : null,
          telefono ? `Mi teléfono: ${telefono}` : null,
        ].filter(Boolean).join("\n");

        const openWhatsApp = () => {
          window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`, "_blank", "noopener,noreferrer");
        };

        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 15000);

        fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          signal: controller.signal,
          body: JSON.stringify({ nombre, correo, telefono, curso: exam, fromUrl: window.location.href }),
        })
          .then(async (response) => {
            if (!response.ok) {
              const payload = await response.json().catch(() => ({}));
              throw new Error(payload.error || "No se pudo enviar el mensaje.");
            }

            if (status) {
              status.style.color = "";
              status.innerHTML = `¡Mensaje enviado perfectamente! <br/><span class="text-xs text-teal-400/80 mt-1 block">Abriendo WhatsApp en 5 segundos...</span>`;
            }
            window.dataLayer?.push({ event: "generate_lead", lead_exam: exam });

            setTimeout(() => {
              if (status) status.innerHTML = "¡Mensaje enviado perfectamente!";
              openWhatsApp();
            }, 5000);
          })
          .catch((error) => {
            // Nunca mostrar un éxito falso: si el correo falla, seguimos por WhatsApp.
            console.error("[contact] No se pudo enviar el formulario:", error);
            if (status) {
              status.style.color = "#fca5a5";
              status.innerHTML = `No pudimos enviar el correo. <br/><span class="text-xs opacity-80 mt-1 block">Te abrimos WhatsApp para no perder tu mensaje.</span>`;
            }
            setTimeout(openWhatsApp, 1500);
          })
          .finally(() => {
            clearTimeout(timeout);
            form.dataset.submitting = "false";
            if (submitBtn) submitBtn.disabled = false;
          });
      });
    }
  }

  initCoursePage();
  document.addEventListener("astro:page-load", initCoursePage);
</script>
